{
  "rootDir": "..",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": { "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json", "diagnostics": { "ignoreCodes": [151002] } }] },
  "moduleFileExtensions": ["js", "json", "ts"],
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/entorno-e2e.ts"],
  "maxWorkers": 1
}
